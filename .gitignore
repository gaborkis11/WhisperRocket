# Virtual environment
venv/
__pycache__/
*.pyc

# Backup files
*.save
*.save.*

# Test audio files
*.wav
!assets/*.wav

# IDE
.idea/
.vscode/

# User config (generated during install)
config.json

# Secrets - tokens live in ~/.config/whisperrocket/.env, never in the repo
.env
.env.*
*.env

# macOS
.DS_Store

# Build output (PyInstaller/AppImage)
build/
build_appimage/
dist/
# PyInstaller drops generated specs in the project root; the one under
# packaging/ is hand-maintained and build_appimage.sh cannot run without it, so
# it has to ship - a fresh clone could not build an AppImage while it was ignored.
*.spec
!packaging/whisperrocket.spec

# Development files (not for public repo)
CLAUDE.md
tasks/
.claude/

# Personal settings - never committed.
#
# These normally live in ~/.config/whisperrocket/, which is outside this
# repository, so git cannot see them at all. That is the real protection; the
# rules below are the second line of defence for a copy that ends up in the
# project directory during development.
#
# Deliberately pattern-based rather than a list of filenames: a personal file
# added by a later feature is covered without anyone having to remember to
# update this list. The .example templates are re-included below - those are the
# versions that ship.
*style_profile*.md
*dictionary*.json
prompt_*.md
*history.json
personal/
private/
!*.example.md
!*.example.json

# Runtime state files
.download_state.json
