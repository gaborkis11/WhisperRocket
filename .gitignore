# Virtual environment
venv/
__pycache__/
*.pyc

# Backup files
*.save
*.save.*

# Test audio files
*.wav
!assets/*.wav

# IDE
.idea/
.vscode/

# User config (generated during install)
config.json

# Secrets - tokens live in ~/.config/whisperrocket/.env, never in the repo
.env
.env.*
*.env

# macOS
.DS_Store

# Build output (PyInstaller/AppImage)
build/
build_appimage/
dist/
*.spec

# Development files (not for public repo)
CLAUDE.md
tasks/
.claude/

# AI enhancement - user-specific, never committed.
# These live in ~/.config/whisperrocket/ ; this is a safety net in case a copy
# ends up in the project directory during development.
style_profile.md
dictionary.json
prompt_transcript.md
prompt_compose.md

# Runtime state files
.download_state.json
