#!/usr/bin/env bash
#
# WhisperRocket pre-commit hook - refuses to commit credentials or personal data.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Tokens belong in ~/.config/whisperrocket/.env (see secrets_manager.py), and
# personal settings - style profile, custom dictionary, edited prompts, history -
# belong in ~/.config/whisperrocket/ as well. Never in a tracked file.
#
# .gitignore already covers all of these, but `git add -f` bypasses it, so they
# are checked again here - with the same patterns as .gitignore, not a list of
# exact names: until 2026-11-24 this hook let "my_style_profile.md" and
# CLAUDE.md through although .gitignore covered both. Rule 4 goes further than
# any filename can: the real values in ~/.config/whisperrocket/.env are refused
# in every staged file, whatever it is called.

set -uo pipefail

RED=$'\033[0;31m'; YELLOW=$'\033[1;33m'; RESET=$'\033[0m'
failed=0

report() {
    if [ "$failed" -eq 0 ]; then
        printf '%s\n' "${RED}✖ Commit blocked: credential or personal data in staged changes${RESET}" >&2
    fi
    failed=1
    printf '  %s\n' "$1" >&2
}

# R included: renaming a template to a personal name is still adding that file
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged_files" ] && exit 0

# 1. Never commit a secrets file, whatever it is named
while IFS= read -r file; do
    case "$(basename "$file")" in
        .env|.env.*|*.env)
            report "$file — secrets file (keep it in ~/.config/whisperrocket/)"
            ;;
    esac
done <<< "$staged_files"

# 2. Never commit personal settings or internal files. These describe a specific
#    person - how they write, which names they use, what they dictated - and the
#    repository is public. The .example.* templates are the versions that ship.
#    Keep these patterns in step with the "Personal settings" block in .gitignore.
while IFS= read -r file; do
    name=$(basename "$file")
    case "$name" in
        *.example.md|*.example.json) continue ;;
    esac
    case "$file" in
        tasks/*|.claude/*|personal/*|private/*|*/personal/*|*/private/*)
            report "$file — internal or personal folder, never published"
            continue
            ;;
    esac
    case "$name" in
        DEVLOG.md|CLAUDE.md)
            report "$file — internal development file, deliberately not published"
            ;;
        *style_profile*.md|*dictionary*.md|*dictionary*.json*|*dictionary*.txt|prompt_*.md|*history.json|config.json)
            report "$file — personal settings (keep it in ~/.config/whisperrocket/; commit the .example version instead)"
            ;;
    esac
done <<< "$staged_files"

# 3. Scan added lines for credential shapes.
#    Patterns are deliberately length-bound so documenting them stays safe.
# Parallel arrays - a pattern may contain ':' (e.g. [[:space:]]), so the label
# cannot be packed into the same string.
PATTERNS=(
    'hf_[A-Za-z0-9]{30,}'
    'sk-[A-Za-z0-9_-]{20,}'
    'ghp_[A-Za-z0-9]{30,}'
    'github_pat_[A-Za-z0-9_]{30,}'
    'AKIA[0-9A-Z]{16}'
    '"hf_token"[[:space:]]*:[[:space:]]*"[^"]+"'
)
LABELS=(
    'HuggingFace token'
    'OpenAI/Anthropic-style API key'
    'GitHub personal access token'
    'GitHub fine-grained token'
    'AWS access key id'
    'hf_token value in JSON'
)

while IFS= read -r file; do
    # Skip binary files and this hook itself
    [ "$file" = ".githooks/pre-commit" ] && continue
    git diff --cached --numstat -- "$file" | grep -q '^-' && continue

    added=$(git diff --cached -U0 --diff-filter=ACM -- "$file" \
            | grep '^+' | grep -v '^+++' || true)
    [ -z "$added" ] && continue

    for i in "${!PATTERNS[@]}"; do
        if printf '%s' "$added" | grep -Eq -- "${PATTERNS[$i]}"; then
            report "$file — looks like a ${LABELS[$i]}"
        fi
    done
done <<< "$staged_files"

# 4. The real secrets, wherever they are pasted. The values are read from the
#    .env file and handed to grep through a pipe - never printed, never written
#    to disk. Values shorter than 12 characters are skipped: too likely to
#    occur by chance, and no real token is that short.
env_file="${WHISPERROCKET_ENV_FILE:-$HOME/.config/whisperrocket/.env}"
if [ -r "$env_file" ]; then
    secret_values() {
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in ''|\#*) continue ;; esac
            value=${line#*=}
            value=${value%\"}; value=${value#\"}; value=${value%\'}; value=${value#\'}
            [ "${#value}" -ge 12 ] && printf '%s\n' "$value"
        done < "$env_file"
    }
    if [ -n "$(secret_values)" ]; then
        while IFS= read -r file; do
            if git diff --cached -U0 -- "$file" | grep '^+' | grep -v '^+++' \
                    | grep -qF -f <(secret_values); then
                report "$file — contains a real secret from ~/.config/whisperrocket/.env"
            fi
        done <<< "$staged_files"
    fi
fi

if [ "$failed" -ne 0 ]; then
    printf '\n%s\n' "${YELLOW}Credentials: move the value to ~/.config/whisperrocket/.env (mode 0600)" >&2
    printf '%s\n' "and read it via secrets_manager.get_secret(), then stage again." >&2
    printf '%s\n' "Personal settings: unstage the file (git restore --staged <file>). It" >&2
    printf '%s\n' "belongs in ~/.config/whisperrocket/; commit the .example template instead." >&2
    printf '%s\n\n' "If this is a false positive: git commit --no-verify${RESET}" >&2
    exit 1
fi

exit 0
